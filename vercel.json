{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "VITE_API_URL=/api/v1 npm run build"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "vercel-handler.js",
      "functions": {
        "vercel-handler.js": {
          "maxDuration": 30,
          "includeFiles": "node_modules/bcrypt/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
