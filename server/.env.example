PORT=5000
CLIENT_ORIGIN=
NODE_ENV=
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
# Use public DNS if Node.js SRV lookups fail (querySrv ECONNREFUSED on Windows)
DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=
JWT_EXPIRES_IN=
RESERVATION_CLEANUP_INTERVAL_MS=
# Server-side only. Never expose this to the client bundle.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5
AI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
# Log verbosity: trace|debug|info|warn|error|fatal. Defaults to info (silent in tests).
LOG_LEVEL=
# Requests per IP per minute across the whole API. Health and /metrics are exempt.
GLOBAL_RATE_LIMIT_MAX=
# How often stalled refunds are re-driven, in ms. Defaults to 10 minutes.
REFUND_RECONCILE_INTERVAL_MS=
